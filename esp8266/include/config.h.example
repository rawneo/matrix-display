// Copy this file to config.h and fill in your values.
#pragma once

#define WIFI_SSID     "your-ssid"
#define WIFI_PASS     "your-password"
#define HOSTNAME      "matrix-display"

// Static IP (comment these four lines out to use DHCP instead).
#define STATIC_IP     192, 168, 2, 101
#define STATIC_GW     192, 168, 2, 1
#define STATIC_MASK   255, 255, 255, 0
#define STATIC_DNS    192, 168, 2, 1

// Weather location (Open-Meteo). Same pinning as the Pi version.
#define WEATHER_LAT   "30.3165"
#define WEATHER_LON   "78.0322"
#define WEATHER_CITY  "Dehradun"

// POSIX TZ string. IST = UTC+5:30.
#define TZ_INFO       "IST-5:30"

// Panel: 7 cascaded FC-16 MAX7219 modules, DIN=D7, CLK=D5, CS=D8 (HW SPI).
#define MAX_DEVICES   7

// Default brightness 0..15 (the Pi version ran the equivalent of ~1).
#define DEFAULT_INTENSITY 1

// If your animations run mirrored left<->right, flip this.
#define FLIP_X        1

// Set to 1 if the panel is physically mounted upside down.
// The deployed unit (.101) IS mounted upside-down, so this must stay 1 —
// config.h is gitignored and gets recreated from this file on every
// rebuild, so a wrong default here silently flips the display (happened
// 2026-07-28).
#define ROTATE_180    1

// DHT11 data pin (D2 on NodeMCU = GPIO4, same pin number as the Pi build).
#define DHT_PIN       4

// ---- MQTT (Home Assistant broker) ----------------------------------------
// DISABLED 2026-08-12. Set to 1 to restore; everything below is compiled
// out while it is 0. The broker (HAOS Mosquitto on .20) is powered off
// with the rack, and PubSubClient's blocking 5s TCP connect was freezing
// the display for 5s out of every 10s. This feed was publish-only --
// /dhtraw still serves the same DHT reading over HTTP either way.
#define ENABLE_MQTT 0

// Publishes the DHT reading straight to HA, replacing the HTTP poller that
// used to run on jetson2 and then rpi5. Discovery configs are re-published
// on every (re)connect so the entities self-heal on a fresh broker.
// NOTE: PubSubClient's default MQTT_MAX_PACKET_SIZE is 256, which silently
// truncates the discovery payloads — platformio.ini raises it to 512.
#define MQTT_HOST     "192.168.2.20"
#define MQTT_PORT     1883
#define MQTT_USER     "mqtt"
#define MQTT_PASS     "your-mqtt-password"
#define MQTT_CLIENTID "esp8266-clock"

// Publish interval in ms.
#define MQTT_INTERVAL 60000

// Topics. These must match the retained HA discovery configs, or the
// entity_ids change and dashboards/automations silently break.
#define MQTT_TOPIC_TEMP "esp8266/dht/temperature"
#define MQTT_TOPIC_HUM  "esp8266/dht/humidity"
